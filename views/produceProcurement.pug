doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    title Produce Procurement
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="/css/produceProcurement.css")
  body
    nav.navbar.navbar-expand-lg.bg-body-tertiary.fixed-top
      .container-fluid
        a.navbar-brand(href="#") Karibu Groceries Ltd
        button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
          span.navbar-toggler-icon
        .offcanvas.offcanvas-end#offcanvasNavbar
          .offcanvas-header
            h5.offcanvas-title KGL
            button.btn-close(type="button", data-bs-dismiss="offcanvas")
          .offcanvas-body
            ul.navbar-nav.ms-auto
              li.nav-item: a.nav-link(href="/") Home
              li.nav-item: a.nav-link(href="/login") Login
              li.nav-item: a.nav-link(href="/produceProcurement") Produce Procurement
              li.nav-item: a.nav-link(href="/stock") Stock
              li.nav-item: a.nav-link(href="/deferredPayments") Deferred Payments
              li.nav-item: a.nav-link(href="/sales") Sales
              li.nav-item: a.nav-link(href="/managerDashboard") Manager's Dashboard
              li.nav-item: a.nav-link(href="/contacts") Contact

    .container.mt-5.pt-5
      h1.text-center.mb-4 Record Produce Procurement
      form#procurementForm.p-4.shadow-lg.rounded.bg-light(action="/produceProcurement" method="post" onsubmit="validateProcurementForm(event)")
        .mb-3
          label.form-label(for="Pname") Produce Name:
          input#Pname.form-control(type="text" name="Pname")
          div#error-produce.text-danger

        .mb-3
          label.form-label(for="Tproduce") Type of Produce:
          input#Tproduce.form-control(type="text" name="Tproduce")
          div#error-type.text-danger

        .mb-3
          label.form-label(for="datePicker") Date of Procurement:
          input#datePicker.form-control(type="date" name="Dprocurement")
          div#error-date.text-danger

        .mb-3
          label.form-label(for="timePicker") Time of Procurement:
          input#timePicker.form-control(type="time" name="Tprocurement")
          div#error-time.text-danger

        .mb-3
          label.form-label(for="tonnage") Tonnage (kg):
          input#tonnage.form-control(type="text" name="tonnage")
          div#error-tonnage.text-danger

        .mb-3
          label.form-label(for="cost") Cost in UgX:
          input#cost.form-control(type="text" name="cost")
          div#error-cost.text-danger

        .mb-3
          label.form-label(for="dealerName") Dealer's Name:
          input#dealerName.form-control(type="text" name="dealerName")
          div#error-dealer.text-danger

        .mb-3
          label.form-label(for="dealerContact") Dealer's Contact:
          input#dealerContact.form-control(type="text" name="dealerContact")
          div#error-contact.text-danger

        .mb-3
          label.form-label(for="autoSizingSelect") Branch Name:
          select#branchSelect.form-select(name="branchName")
            option(selected) Choose...
            option(value="Maganjo") Maganjo
            option(value="Matugga") Matugga
          div#error-branch.text-danger

        .mb-3
          label.form-label(for="Psold") Price to be sold At (Ugx):
          input#Psold.form-control(type="text" name="Psold")
          div#error-psold.text-danger

        button.btn.btn-primary.w-100(type="submit") Record Procurement

    // Bootstrap JS + custom validation script
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="/js/produceProcurement.js")
