doctype html
head
  meta(charset='utf-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  title Update Sale 
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH' crossorigin='anonymous')
  link(rel='stylesheet' href='/css/sales.css')
|  &grave; 
.container.mt-5
  h1.text-center.mb-4 Sales Registration Form
  form#myForm.p-4.shadow-lg.rounded.bg-light(action='/sales/updateSale/'+sale._id method="post" onsubmit='event formValidite()')
    .mb-3
      label.form-label(for='produceName') Produce Name:
      input#Pname.form-control(name='pname' value=sale.pname)
    .mb-3
      label.form-label(for='typeOfProduce') Type of Produce:
      input#Tproduce.form-control(name='tproduce' value=sale.tproduce)
    .mb-3
      label.form-label(for='datePicker') Date of Sale:
      input#datePicker.form-control(name='dsale' value=sale.dsale)
    .mb-3
      label.form-label(for='timePicker') Time of Sale:
      input#timePicker.form-control(name='tsale' value=sale.tsale)
    .mb-3
      label.form-label(for='Qsold') Quantity Sold (kg):
      input#Qsold.form-control(name='qsale' value=sale.qsale)
    .mb-3
      label.form-label(for='Sprice') Selling Price per kg:
      input#Sprice.form-control(name='sprice')
    .mb-3
      label.form-label(for='Tamount') Total Amount:
      input#Tamount.form-control(name='tamount')
    .mb-3
      label.form-label(for='customerName') Customer Name:
      input#customerName.form-control(name='customerName')
    .mb-3
      label.form-label(for='customerContact') Customer Contact:
      input#customerContact.form-control(name='customerContact')
    .mb-3
      label.form-label(for='autoSizingSelect') Payment Method:
      select#autoSizingSelect.form-select(name='paymentMethod')
        option(selected='') Choose...
        option(value='Cash') Cash
        option(value='Mobile Money') Mobile Money
        option(value='Bank Transfer') Bank Transfer
    button.btn.btn-primary.w-100(type='submit') Submit
// Bootstrap JS
script(src='sales.js')
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js' integrity='sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz' crossorigin='anonymous')
