doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Update Sale - Karibu Groceries Ltd
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet' crossorigin='anonymous')
    link(rel='stylesheet' href='/css/sales.css')
  body
    .container.mt-5
      h1.text-center.mb-4 Update Sale Record

      form#myForm.p-4.shadow-lg.rounded.bg-light(action='/sales/updateSale/' + sale._id, method='post', onsubmit='return formValidate()')
        .mb-3
          label.form-label(for='Pname') Produce Name:
          input#Pname.form-control(type='text', name='pname', required, value=sale.pname)

        .mb-3
          label.form-label(for='Tproduce') Type of Produce:
          input#Tproduce.form-control(type='text', name='tproduce', required, value=sale.tproduce)

        .mb-3
          label.form-label(for='datePicker') Date of Sale:
          input#datePicker.form-control(type='date', name='dsale', required, value=sale.dsale ? sale.dsale.toISOString().substring(0, 10) : '')

        .mb-3
          label.form-label(for='timePicker') Time of Sale:
          input#timePicker.form-control(type='time', name='tsale', required, value=sale.tsale)

        .mb-3
          label.form-label(for='Qsold') Quantity Sold (kg):
          input#Qsold.form-control(type='number', name='qsold', required, min='0', value=sale.qsold)

        .mb-3
          label.form-label(for='Sprice') Selling Price per kg:
          input#Sprice.form-control(type='number', name='uprice', required, step='0.01', min='0', value=sale.uprice)

        .mb-3
          label.form-label(for='Tamount') Total Amount:
          input#Tamount.form-control(type='number', name='tamount', required, step='0.01', min='0', value=sale.tamount)

        .mb-3
          label.form-label(for='customerName') Customer Name:
          input#customerName.form-control(type='text', name='customerName', required, value=sale.customerName)

        .mb-3
          label.form-label(for='customerContact') Customer Contact:
          input#customerContact.form-control(type='text', name='customerContact', required, value=sale.customerContact)

        .mb-3
          label.form-label(for='autoSizingSelect') Payment Method:
          select#autoSizingSelect.form-select(name='paymentMethod', required)
            option(value='') Choose...
            option(value='Cash', selected=sale.paymentMethod === 'Cash') Cash
            option(value='Mobile Money', selected=sale.paymentMethod === 'Mobile Money') Mobile Money
            option(value='Bank Transfer', selected=sale.paymentMethod === 'Bank Transfer') Bank Transfer

        button.btn.btn-primary.w-100(type='submit') Update Sale

    // ✅ JS Scripts
    script(src='/js/sales.js')
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js' crossorigin='anonymous')
