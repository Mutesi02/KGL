doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title Update Sale
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH' crossorigin='anonymous')
    link(rel='stylesheet' href='/css/sales.css')
  body
    .container.mt-5
      h1.text-center.mb-4 Sales Registration Form
      form#myForm.p-4.shadow-lg.rounded.bg-light(action='/sales/updateSale/${sale._id}' method="post" onsubmit='return formValidate()')
        .mb-3
          label.form-label(for='produceName') Produce Name:
          input#Pname.form-control(name='pname' value=(sale && sale.pname ? sale.pname : ''))
        .mb-3
          label.form-label(for='typeOfProduce') Type of Produce:
          input#Tproduce.form-control(name='tproduce' value=(sale && sale.tproduce ? sale.tproduce : ''))
        .mb-3
          label.form-label(for='datePicker') Date of Sale:
          input#datePicker.form-control(type='date' name='dsale' value=(sale && sale.dsale ? sale.dsale.toISOString().substring(0, 10) : ''))

        .mb-3
          label.form-label(for='timePicker') Time of Sale:
          input#timePicker.form-control(type='time' name='tsale' value=(sale && sale.tsale ? sale.tsale : ''))

        .mb-3
          label.form-label(for='Qsold') Quantity Sold (kg):
          input#Qsold.form-control(name='qsold' value=(sale && sale.qsold ? sale.qsold : ''))

        .mb-3
          label.form-label(for='Sprice') Selling Price per kg:
          input#Sprice.form-control(name='uprice' value=(sale && sale.uprice ? sale.uprice : ''))

        .mb-3
          label.form-label(for='Tamount') Total Amount:
          input#Tamount.form-control(name='tamount' value=(sale && sale.tamount ? sale.tamount : ''))

        .mb-3
          label.form-label(for='customerName') Customer Name:
          input#customerName.form-control(name='customerName' value=(sale && sale.customerName ? sale.customerName : ''))

        .mb-3
          label.form-label(for='customerContact') Customer Contact:
          input#customerContact.form-control(name='customerContact' value=(sale && sale.customerContact ? sale.customerContact : ''))

        .mb-3
          label.form-label(for='autoSizingSelect') Payment Method:
          select#autoSizingSelect.form-select(name='paymentMethod')
            option(value='') Choose...
            option(value='Cash' selected=(sale && sale.paymentMethod === 'Cash')) Cash
            option(value='Mobile Money' selected=(sale && sale.paymentMethod === 'Mobile Money')) Mobile Money
            option(value='Bank Transfer' selected=(sale && sale.paymentMethod === 'Bank Transfer')) Bank Transfer

        button.btn.btn-primary.w-100(type='submit') Submit
    script(src='/js/sales.js')
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js' integrity='sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz' crossorigin='anonymous')
