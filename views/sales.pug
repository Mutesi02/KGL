doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    title Karibu Groceries Ltd - Sales

    // Bootstrap CSS CDN
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="/css/sales.css")

  body
    // Navbar
    nav.navbar.navbar-expand-lg.fixed-top(style="background-color: #004d00;")
      .container-fluid
        a.navbar-brand(href="#", style="color: white;") KGL
        button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
          span.navbar-toggler-icon
        .offcanvas.offcanvas-end#offcanvasNavbar
          .offcanvas-header
            h5.offcanvas-title KGL
            button.btn-close(type="button", data-bs-dismiss="offcanvas")
          .offcanvas-body
            ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
              li.nav-item
                a.nav-link(href="/") Home
              li.nav-item
                a.nav-link(href="/produceProcurement") Produce Procurement
              li.nav-item
                a.nav-link(href="/addStock") Stock
              li.nav-item
                a.nav-link(href="/login") Login
              li.nav-item
                a.nav-link(href="/stockdata") Sales
              li.nav-item
                a.nav-link(href="/deferredPayments") Deferred Payments
              li.nav-item
                a.nav-link(href="/managerDash") Manager's Dashboard
              li.nav-item
                a.nav-link(href="/contacts") Contact
            form.d-flex.mt-3(role="search")
              input.form-control.me-2(type="search", placeholder="Search")
              button.btn.btn-outline-light(type="submit") Search

    // Main Content
    .container.mt-5.pt-5(style="padding-top: 100px;")
      h1.text-center.mb-4 Sales Produce

      form#myForm.p-4.shadow-lg.rounded.bg-light(action=`/sales/addSale/${stock._id}`, method='post' onsubmit='ValidityForm(event)')
        .mb-3
          label.form-label(for='produceName') Produce Name:
          input#produceName.form-control(type='text', name='pname', value=stock.pname)
          small.text-danger#produce-error

        .mb-3
          label.form-label(for='Tproduce') Type of Produce:
          input#Tproduce.form-control(type='text', name='tproduce', value=stock.tproduce)
          small.text-danger#type-error

        .mb-3
          label.form-label(for='datePicker') Date of Sale:
          input#datePicker.form-control(type='date', name='dsale')
          small.text-danger#date-error

        .mb-3
          label.form-label(for='timePicker') Time of Sale:
          input#timePicker.form-control(type='time', name='tsale')
          small.text-danger#time-error

        .mb-3
          label.form-label(for='Qsold') Quantity Sold (kg):
          input#Qsold.form-control(type='number', name='qsold')
          small.text-danger#quantity-error

        .mb-3
          label.form-label(for='Sprice') Unit Price per kg:
          input#Sprice.form-control(type='number', name='uprice', value=stock.uprice)
          small.text-danger#unit-error

        .mb-3
          label.form-label(for='Tamount') Total Amount:
          input#Tamount.form-control(type='number', name='tamount')
          small.text-danger#total-error

        .mb-3
          label.form-label(for='customerName') Customer Name:
          input#customerName.form-control(type='text', name='customerName')
          small.text-danger#customer-error

        .mb-3
          label.form-label(for='customerContact') Customer Contact:
          input#customerContact.form-control(type='text', name='customerContact')
          small.text-danger#contact-error

        .mb-3
          label.form-label(for='seller') Seller:
          input#seller.form-control(type='text', name='seller', value=fullName)
          small.text-danger#seller-error

        .mb-3
          label.form-label(for='branch') Branch:
          select.form-select(name='branch')
            option(value=branch)= branch
          small.text-danger#branch-error

        .mb-3
          label.form-label(for='paymentMethod') Payment Method:
          select.form-select(name='paymentMethod')
            option(selected value='') Choose...
            option(value='Cash') Cash
            option(value='Mobile Money') Mobile Money
            option(value='Bank Transfer') Bank Transfer
          small.text-danger#payment-error

        button.btn.btn-primary.w-100(type='submit') Submit

    // JS
    script(src="/js/sales.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
