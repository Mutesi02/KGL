doctype html
head
  meta(charset='utf-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  title Stock Management
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH' crossorigin='anonymous')
  link(rel='stylesheet' href='/css/stock.css')
  //  Navbar 
nav.navbar.navbar-expand-lg.fixed-top
  .container-fluid
    a.navbar-brand(href="#") KGL
    button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
      span.navbar-toggler-icon
    .offcanvas.offcanvas-end#offcanvasNavbar
      .offcanvas-header
        h5.offcanvas-title KGL
        button.btn-close(type="button", data-bs-dismiss="offcanvas")
      .offcanvas-body
        ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
          li.nav-item
            a.nav-link(href="/") Home
          li.nav-item
            a.nav-link(href="index/produce-procurement.html") Produce Procurement
          li.nav-item
            a.nav-link(href="/addStock") Stock
          li.nav-item
            a.nav-link(href="/login") Login
          li.nav-item
            a.nav-link(href="/stockdata") Sales
          li.nav-item
            a.nav-link(href="index/deferred-payments.html") Deferred Payments
          li.nav-item
            a.nav-link(href="/managerDash") Manager's Dashboard
          li.nav-item
            a.nav-link(href="/contactUs") Contact
        form.d-flex.mt-3(role="search")
          input.form-control.me-2(type="search", placeholder="Search")
          button.btn.btn-outline-light(type="submit") Search

.container
  h1 Stock Management
  input#search(type='text' placeholder='Search items...')
  table
    thead
      tr
        th Product Name 
        th Time of  Produce 
        th Quantity of Produce 
        th Unit Price
        th Sale
        th Update 
        th Delete 
    tbody#stock-table
      if stocks.length
             each stock in stocks 
              tr
                td #{stock.pname}
                td #{stock.tproduce}
                td #{stock.qproduct}
                td #{stock.uprice}
                td 
                  a.btn.btn-secondary.btn-block(href="/sales/addSale/"+stock._id) Sale 
                td 
                  a.btn.btn-primary.btn-block(href="/sales/updateSale/"+stock._id) Update 
                td
                  form(action="/stock/delete/"+stock._id method="post")
                    input(type="hidden" name="id" value=stock._id)
                    button.btn.btn-danger.btn-block(type="submit") Delete       
  button#add-stock Add Stock
script(src='stock.js')
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js' integrity='sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz' crossorigin='anonymous')
