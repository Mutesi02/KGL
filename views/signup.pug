doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title SignUp
    // Bootstrap CSS
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet', href='/css/signup.css')
  body
    .container.mt-5
      .row.justify-content-center
        .col-md-6.col-lg-5
          .card.shadow
            .card-body
              h2#formTitle.text-center.mb-4.text-success Sign Up
              form#authForm(action="/signingup" method="post")
                .mb-3
                  label.form-label(for="fullName") Full Name
                  input#name.form-control(type='text', name='fullName', placeholder='', required)
                .mb-3
                  label.form-label(for="email") Email
                  input#email.form-control(type='email', name='email', placeholder='', required)
                .mb-3
                  label.form-label(for="password") Password
                  input#password.form-control(type='password', name='password', placeholder='Enter password', required)
                .mb-3
                  label.form-label(for="confirmPassword") Confirm Password
                  input#confirmPassword.form-control(type='password', name='confirmPassword', placeholder='Re-enter password', required)

                .mb-3
                  label.form-label.mb-2 Role
                  .form-check
                    input#manager.form-check-input(type='radio', name='role', value="manager")
                    label.form-check-label(for='manager') Manager
                  .form-check
                    input#director.form-check-input(type='radio', name='role', value="director", checked)
                    label.form-check-label(for='director') Director
                  .form-check
                    input#salesagent.form-check-input(type='radio', name='role', value="salesagent")
                    label.form-check-label(for='salesagent') Sales Agent

                .mb-4.d-flex.align-items-center.gap-3
                  label.form-label.mb-0(for='branchname') Branch:
                  select#branchname.form-select(name='branch', required)
                    option(value='') Select branch
                    option(value='matugga') Matugga
                    option(value='maganjo') Maganjo

                button.btn.btn-custom-green.w-100(type='submit') Sign Up

              p.text-center.mt-3
                | Already have an account?
                a(href='/login') Login here

    // Bootstrap Bundle with Popper.js
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    // Your Custom JavaScript File
    script(src='/login/addInformation')
