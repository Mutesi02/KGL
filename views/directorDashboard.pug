meta(charset="UTF-8")
meta(name="viewport", content="width=device-width,initial-scale=1")
title KGL Director Dashboard
link(rel="stylesheet", href="/css/directorDashboard.css")
link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
nav.navbar
  .logo KGL
  .greeting Welcome Mr. Orban
  button.logout-btn Logout
section.dashboard
  .cards
    .card
      h3 Total Revenue
      p#totalRevenue UGX 0
    .card
      h3 Total Tons Sold
      p#totalTons 0 Tons
    .card
      h3 Outstanding Credit
      p#outstandingCredit UGX 0
    .card
      h3 Total Transactions
      p#totalTransactions 0
  .chart-section
    h2 Sales by Produce
    canvas#produceChart
  .branch-performance
    h2 Branch Performance
    table
      thead
        tr
          th Branch Name
          th Total Revenue
          th Total Tons Sold
      tbody#branchTableBody
        //  JS will populate this 
footer.
  
