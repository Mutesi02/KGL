doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    title KGL Director Dashboard
    link(rel="stylesheet", href="/css/directorDashboard.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")

  body
    // Navbar copied from index.pug
    nav.navbar.navbar-expand-lg.fixed-top
      .container-fluid
        a.navbar-brand(href="#") KGL
        button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
          span.navbar-toggler-icon
        .offcanvas.offcanvas-end#offcanvasNavbar
          .offcanvas-header
            h5.offcanvas-title KGL
            button.btn-close(type="button", data-bs-dismiss="offcanvas")
          .offcanvas-body
            ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
              li.nav-item
                a.nav-link(href="/") Home
              li.nav-item
                a.nav-link(href="/produceProcurement") Produce Procurement
              li.nav-item
                a.nav-link(href="/addStock") Stock
              li.nav-item
                a.nav-link(href="/login") Login
              li.nav-item
                a.nav-link(href="/stockdata") Sales
              li.nav-item
                a.nav-link(href="/deferredPayments") Deferred Payments
              li.nav-item
                a.nav-link(href="/managerDash") Manager's Dashboard
              li.nav-item
                a.nav-link(href="/contacts") Contact
            form.d-flex.mt-3(role="search")
              input.form-control.me-2(type="search", placeholder="Search")
              button.btn.btn-outline-light(type="submit") Search

    // Main Dashboard Section
    section.dashboard.mt-5.pt-4
      .container
        h2.greeting.text-center.mb-4 Welcome Mr. Orban

        .cards.row.row-cols-1.row-cols-md-4.g-4.mb-4
          .col
            .card.text-center.shadow-sm
              .card-body
                h3.card-title Total Revenue
                p#totalRevenue.card-text UGX 0
          .col
            .card.text-center.shadow-sm
              .card-body
                h3.card-title Total Tons Sold
                p#totalTons.card-text 0 Tons
          .col
            .card.text-center.shadow-sm
              .card-body
                h3.card-title Outstanding Credit
                p#outstandingCredit.card-text UGX 0
          .col
            .card.text-center.shadow-sm
              .card-body
                h3.card-title Total Transactions
                p#totalTransactions.card-text 0

        .chart-section.mb-5
          h2 Sales by Produce
          canvas#produceChart(style="width: 100%; height: 400px;")

        .branch-performance
          h2 Branch Performance
          table.table.table-bordered.table-hover
            thead
              tr
                th Branch Name
                th Total Revenue
                th Total Tons Sold
            tbody#branchTableBody
              // Populated by JS

    footer.text-center.mt-5.mb-3
      p Karibu Groceries Ltd — Director Dashboard © 2025

    script(src="https://cdn.jsdelivr.net/npm/chart.js")
    script(src="/js/directorDashboard.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
