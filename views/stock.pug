doctype html
head
  meta(charset='utf-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  title Stock Form
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH' crossorigin='anonymous')
  link(rel='stylesheet' href='/css/sales.css')
|  &grave; 
//  Navbar 
nav.navbar.navbar-expand-lg.fixed-top
  .container-fluid
    a.navbar-brand(href="#") KGL
    button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
      span.navbar-toggler-icon
    .offcanvas.offcanvas-end#offcanvasNavbar
      .offcanvas-header
        h5.offcanvas-title KGL
        button.btn-close(type="button", data-bs-dismiss="offcanvas")
      .offcanvas-body
        ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
          li.nav-item
            a.nav-link(href="/") Home
          li.nav-item
            a.nav-link(href="index/produce-procurement.html") Produce Procurement
          li.nav-item
            a.nav-link(href="/addStock") Stock
          li.nav-item
            a.nav-link(href="/login") Login
          li.nav-item
            a.nav-link(href="/stockdata") Sales
          li.nav-item
            a.nav-link(href="index/deferred-payments.html") Deferred Payments
          li.nav-item
            a.nav-link(href="/managerDash") Manager's Dashboard
          li.nav-item
            a.nav-link(href="/contactUs") Contact
        form.d-flex.mt-3(role="search")
          input.form-control.me-2(type="search", placeholder="Search")
          button.btn.btn-outline-light(type="submit") Search

.container.mt-5
  h1.text-center.mb-4 Produce
  form#myForm.p-4.shadow-lg.rounded.bg-light(action='/addStock' method="post" onsubmit='ValidityForm(event)' enctype='multipart/form-data')
    .mb-3
      label.form-label(for='produceName') Produce Name:
      input#Pname.form-control(type='text' name='pname')
    .mb-3
      label.form-label(for='typeOfProduce') Type of Produce:
      input#Tproduce.form-control(type='text' name='tproduce')
    .mb-3
      label.form-label(for='datePicker') Date of product input:
      input#datePicker.form-control(type='date' name='dproduct')
    .mb-3
      label.form-label(for='timePicker') Time of product input:
      input#timePicker.form-control(type='time' name='tproduct')
    .mb-3
      label.form-label(for='Qsold') Quantity of product input (kg):
      input#Qsold.form-control(type='number' name='qproduct')
    .mb-3
      label.form-label(for='Sprice') Unit Price per kg:
      input#Sprice.form-control(type='number' name='uprice')
    .mb-3
      label.form-label(for='Tamount') Total Amount:
      input#Tamount.form-control(type='number' name='tamount')
    .mb-3
      label.form-label(for='customerName') Supplier Name:
      input#customerName.form-control(type='text' name='supplierName')
    .mb-3
      label.form-label(for='customerContact') Supplier Contact:
      input#customerContact.form-control(type='text' name='supplierContact')
    .mb-3
      label.form-label(for='timePicker') Produce Image
      input#timePicker.form-control(type='file' name='image')
    .mb-3
      label.form-label(for='branch') Branch
      select#autoSizingSelect.form-select(name='branch')
        option(selected='') Choose...
        option(value='Mattuga') Matugga
        option(value='Maganjo') Manganjo
    .mb-3
      label.form-label(for='autoSizingSelect') Payment Method:
      select#autoSizingSelect.form-select(name='paymentMethod')
        option(selected='') Choose...
        option(value='Cash') Cash
        option(value='Mobile Money') Mobile Money
        option(value='Bank Transfer') Bank Transfer
    button.btn.btn-primary.w-100(type='submit') Submit
// Bootstrap JS
script(src='sales.js')
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js' integrity='sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz' crossorigin='anonymous')
