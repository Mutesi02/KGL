doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title Sales List
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', rel='stylesheet')
    link(rel='stylesheet' href='/css/saleslist.css')
  
  body
    .container.mt-5
      h1.text-center.mb-4 Sales List

      .mb-3
        input#search.form-control(type='text' placeholder='Search sales...')

      table.table.table-striped.table-bordered
        thead.table-dark
          tr
            th Produce Name
            th Type
            th Time of Sale
            th Quantity Sold (kg)
            th Total Amount
            th Customer Name
            th Customer Contact
            th Payment Method
            th Date of Sale
            th Update
            th Delete
        tbody#stock-table
          if sales.length
            each sale in sales
              tr
                td #{sale.pname}
                td #{sale.tproduce}
                td #{sale.tsale}
                td #{sale.qsold}
                td #{sale.tamount}
                td #{sale.customerName}
                td #{sale.customerContact}
                td #{sale.paymentMethod}
                td #{moment(sale.dsale).format('DD-MM-YYYY')}
                td
                  a.btn.btn-sm.btn-primary(href='/sales/updateSale/' + sale._id) Update
                td
                  form(action='/sales/deleteSale' method='post')
                    input(type='hidden' name='id' value=sale._id)
                    button.btn.btn-sm.btn-danger(type='submit') Delete
          else
            tr
              td(colspan='11' class='text-center') No sales recorded.

      .mt-4.text-end
        a.btn.btn-success(href='/stock') + Add Stock

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script.
      // Optional: simple search functionality
      const searchInput = document.getElementById('search');
      searchInput.addEventListener('input', function () {
        const filter = this.value.toLowerCase();
        const rows = document.querySelectorAll('#stock-table tr');
        rows.forEach(row => {
          const text = row.textContent.toLowerCase();
          row.style.display = text.includes(filter) ? '' : 'none';
        });
      });
