doctype html
html
  head
    title Sales List - Karibu Groceries Ltd
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="/css/saleslist.css")
  body

    // ✅ Navbar from index page
    nav.navbar.navbar-expand-lg.fixed-top
      .container-fluid
        a.navbar-brand(href="#") KGL
        button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
          span.navbar-toggler-icon
        .offcanvas.offcanvas-end#offcanvasNavbar
          .offcanvas-header
            h5.offcanvas-title KGL
            button.btn-close(type="button", data-bs-dismiss="offcanvas")
          .offcanvas-body
            ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
              li.nav-item
                a.nav-link(href="/") Home
              li.nav-item
                a.nav-link(href="produceProcurement") Produce Procurement
              li.nav-item
                a.nav-link(href="/addStock") Stock
              li.nav-item
                a.nav-link(href="/login") Login
              li.nav-item
                a.nav-link(href="/stockdata") Sales
              li.nav-item
                a.nav-link(href="/deferredPayments") Deferred Payments
              li.nav-item
                a.nav-link(href="/managerDash") Manager's Dashboard
              li.nav-item
                a.nav-link(href="/contacts") Contact
            form.d-flex.mt-3(role="search")
              input.form-control.me-2(type="search", placeholder="Search")
              button.btn.btn-outline-light(type="submit") Search

    // ✅ Main Content
    .container.mt-5
      h1.text-center.mb-4.mt-5 Sales Records

      if sales.length
        table.table.table-striped.table-hover
          thead.table-header-green
            tr
              th Produce
              th Type
              th Date
              th Time
              th Quantity (kg)
              th Unit Price
              th Total Amount
              th Buyer
              th Contact
              th Seller
              th Branch
              th Payment
              th Actions
          tbody
            each sale in sales
              tr
                td= sale.product || sale.pname
                td= sale.type || sale.tproduce
                td= (sale.date && sale.date.toDateString()) || (sale.dsale && sale.dsale.toDateString())
                td= sale.time || sale.tsale
                td= sale.quantity || sale.qsold
                td UGX #{sale.price || sale.uprice}
                td UGX #{sale.amount || sale.tamount}
                td= sale.buyerName || sale.customerName
                td= sale.buyerContact || sale.customerContact
                td= sale.agentName || sale.seller
                td= sale.branch
                td= sale.paymentMethod
                td
                  .table-actions.d-flex.gap-2.justify-content-center
                    form(action='/sales/deleteSale', method='post')
                      input(type='hidden', name='id', value=sale._id)
                      button.btn.btn-sm.btn-danger(type='submit') Delete
                    a.btn.btn-sm.btn-primary(href=`/sales/updateSale/${sale._id}`) Update
      else
        p.text-center No sales found.

    // ✅ Scripts
    script(src="/js/index.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
