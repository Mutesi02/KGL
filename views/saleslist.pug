doctype html
html
  head
    title Sales List - Karibu Groceries Ltd
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
  body
    .container.mt-5
      h1.text-center.mb-4 Sales Records

      if sales.length
        table.table.table-striped.table-hover
          thead.table-dark
            tr
              th Produce
              th Type
              th Date
              th Time
              th Quantity (kg)
              th Unit Price
              th Total Amount
              th Buyer
              th Contact
              th Seller
              th Branch
              th Payment
              th Actions
          tbody
            each sale in sales
              tr
                td= sale.product || sale.pname
                td= sale.type || sale.tproduce
                td= (sale.date && sale.date.toDateString()) || (sale.dsale && sale.dsale.toDateString())
                td= sale.time || sale.tsale
                td= sale.quantity || sale.qsold
                td UGX #{sale.price || sale.uprice}
                td UGX #{sale.amount || sale.tamount}
                td= sale.buyerName || sale.customerName
                td= sale.buyerContact || sale.customerContact
                td= sale.agentName || sale.seller
                td= sale.branch
                td= sale.paymentMethod
                td
                  form(action='/sales/deleteSale', method='post')
                    input(type='hidden', name='id', value=sale._id)
                    button.btn.btn-sm.btn-danger(type='submit') Delete
                  a.btn.btn-sm.btn-primary.ms-1(href=`/sales/updateSale/${sale._id}`) Update
      else
        p.text-center No sales found.

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
