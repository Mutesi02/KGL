doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Login
    // Bootstrap CSS
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css', rel='stylesheet')
    link(rel='stylesheet', href='/css/login.css')
  body
    .container.mt-5
      .row.justify-content-center
        .col-md-6.col-lg-5
          .card.shadow
            .card-body
              h2#formTitle.text-center.mb-4.text-success Login
              form#authForm(action="/login" method="post")
                .mb-3
                  label.form-label(for="fullName") Full Name
                  input#name.form-control(type='text', name='fullName', placeholder='', required)
                .mb-3
                  label.form-label(for="email") Email
                  input#email.form-control(type='email', name='email', placeholder='', required)
                .mb-3
                  label.form-label(for="password") Password
                  input#password.form-control(type='password', name='password', placeholder='Enter password', required)
                button.btn.btn-custom-green.w-100(type='submit') Login
              p.text-center.mt-3.text-muted Welcome to our page!

    // Bootstrap Bundle with Popper.js
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
