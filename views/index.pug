meta(charset="utf-8")
meta(name="viewport", content="width=device-width,initial-scale=1")
title Karibu Groceries Ltd - Home

//  Bootstrap CSS CDN 
link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")

style.
  body {
    background-color: #f4fff4;
    font-family: "Segoe UI", sans-serif;
  }
  .navbar {
    background-color: #004d00 !important;
  }
  .navbar-brand, .nav-link {
    color: white !important;
  }
  .nav-link:hover {
    color: #b5ffb5 !important;
  }
  .container {
    margin-top: 80px;
    text-align: center;
  }
  #welcome {
    margin-bottom: 40px;
    animation: fadeInUp 1.2s ease-in-out;
  }
  #welcome p:first-child {
    font-size: 2rem;
    font-weight: bold;
    color: #004d00;
  }
  #welcome p:last-child {
    font-size: 1.25rem;
    color: #333;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .carousel-inner img {
    height: 450px;
    object-fit: cover;
    border-radius: 10px;
  }
  .auth-buttons {
    margin-top: 20px;
  }
  .auth-buttons .btn {
    margin: 0 10px;
    border-radius: 25px;
    padding: 10px 25px;
    font-weight: 500;
  }
  .btn-signin {
    background-color: #004d00;
    color: white;
  }
  .btn-signup {
    background-color: #28a745;
    color: white;
  }
  .btn-signup:hover, .btn-signin:hover {
    opacity: 0.85;
  }
  .carousel-caption {
    bottom: 20%;
  }
  .carousel-text {
    font-size: 2rem;
    font-weight: 600;
    color: #fff;
    background-color: rgba(0, 77, 0, 0.6);
    padding: 10px 20px;
    border-radius: 10px;
    animation: fadeText 1.5s ease-in-out;
  }
  .carousel-desc {
    font-size: 1rem;
    max-width: 700px;
    margin: 10px auto 0;
    color: #f8f9fa;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 12px 20px;
    border-radius: 10px;
    line-height: 1.6;
    animation: fadeText 1.8s ease-in-out;
  }
  @keyframes fadeText {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
//  Main Content 
.container
  #welcome
    p Welcome to Karibu Groceries Ltd
    p Your trusted source for maize, beans, soybeans, groundnuts, and cowpeas

  //  Auth Buttons 
  .auth-buttons
    a.btn.btn-signin(href="/login") Log In
    a.btn.btn-signup(href="/signingup") Sign Up

  //  Carousel 
  #carouselExampleControlsNoTouching.carousel.slide.mt-5(data-bs-touch="false", data-bs-ride="carousel", data-bs-interval="3000")
    .carousel-inner
      .carousel-item.active
        img.d-block.w-100(src="imgs/beans.jpg", alt="Beans")
        .carousel-caption.d-none.d-md-block
          h2.carousel-text Premium Quality Beans
          p.carousel-desc.
            We offer premium quality beans sourced from the best farms, ensuring nutrition and flavor.

      .carousel-item
        img.d-block.w-100(src="imgs/soy5.jpg", alt="Soybeans")
        .carousel-caption.d-none.d-md-block
          h2.carousel-text Nutritious Soybeans
          p.carousel-desc.
            Rich in protein and essential nutrients, our soybeans are ideal for a healthy lifestyle and balanced diet.

      .carousel-item
        img.d-block.w-100(src="imgs/maize3.jpg", alt="Maize")
        .carousel-caption.d-none.d-md-block
          h2.carousel-text Freshly Harvested Maize
          p.carousel-desc.
            Harvested at peak freshness, our maize is perfect for milling, roasting, and cooking, delivering farm-fresh goodness.

      .carousel-item
        img.d-block.w-100(src="imgs/soya.jpg", alt="Soya")
        .carousel-caption.d-none.d-md-block
          h2.carousel-text Organic Cowpeas
          p.carousel-desc.
            Our organically grown cowpeas are a rich source of plant protein, ideal for stews and traditional meals.

    //  Carousel Controls 
    button.carousel-control-prev(type="button", data-bs-target="#carouselExampleControlsNoTouching", data-bs-slide="prev")
      span.carousel-control-prev-icon(aria-hidden="true")
      span.visually-hidden Previous
    button.carousel-control-next(type="button", data-bs-target="#carouselExampleControlsNoTouching", data-bs-slide="next")
      span.carousel-control-next-icon(aria-hidden="true")
      span.visually-hidden Next

//  Bootstrap JS Bundle with Popper 
script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
