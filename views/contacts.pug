doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Contact Us
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="/css/contact.css")
  body
    nav.navbar.navbar-expand-lg.bg-body-tertiary.fixed-top
      .container-fluid
        a.navbar-brand(href="#") Karibu Groceries Ltd
        button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
          span.navbar-toggler-icon
        .offcanvas.offcanvas-end#offcanvasNavbar
          .offcanvas-header
            h5.offcanvas-title KGL
            button.btn-close(type="button", data-bs-dismiss="offcanvas")
          .offcanvas-body
            ul.navbar-nav.ms-auto
              li.nav-item
                a.nav-link(href="/") Home
              li.nav-item
                a.nav-link(href="/login") Login
              li.nav-item
                a.nav-link(href="/produceProcurement") Produce Procurement
              li.nav-item
                a.nav-link(href="/stock") Stock
              li.nav-item
                a.nav-link(href="/deferredPayments") Deferred Payments
              li.nav-item
                a.nav-link(href="/sales") Sales
              li.nav-item
                a.nav-link(href="/managerDashboard") Manager's Dashboard
              li.nav-item
                a.nav-link(href="/contacts") Contact
    .container.mt-5.pt-5
      h2 Contact Us
      p Feel free to reach out to us for any inquiries.
      form#contactForm(method="POST", action="/contacts", onsubmit="validateContactForm(event)")
        .mb-3
          label(for="name") Name:
          input#name.form-control(type="text", name="name", required)
          div#name-error.text-danger.small.mt-1
        .mb-3
          label(for="email") Email:
          input#email.form-control(type="email", name="email", required)
          div#email-error.text-danger.small.mt-1
        .mb-3
          label(for="message") Message:
          textarea#message.form-control(name="message", required)
          div#message-error.text-danger.small.mt-1
        button.btn.btn-primary(type="submit") Send Message
      #responseMessage.mt-3
      .contact-info.mt-5
        h3 Our Address
        p 123 Market Street, Kampala, Uganda
        p Phone: +256 700 123 456
        p Email: info@karibugroceries.com

    // JavaScript includes
    script(src="/js/contacts.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
