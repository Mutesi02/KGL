doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title Stock Form
    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css'
      rel='stylesheet'
      integrity='sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH'
      crossorigin='anonymous'
    )
    link(rel="stylesheet", href="/css/stock.css")
    link(href='https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap' rel='stylesheet')


  body
    // Navbar
    nav.navbar.navbar-expand-lg.fixed-top
      .container-fluid
        a.navbar-brand(href="#") KGL
        button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
          span.navbar-toggler-icon
        .offcanvas.offcanvas-end#offcanvasNavbar
          .offcanvas-header
            h5.offcanvas-title KGL
            button.btn-close(type="button", data-bs-dismiss="offcanvas")
          .offcanvas-body
            ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
              li.nav-item
                a.nav-link(href="/") Home
              li.nav-item
                a.nav-link(href="/produceProcurement") Produce Procurement
              li.nav-item
                a.nav-link(href="/addStock") Stock
              li.nav-item
                a.nav-link(href="/managerDash") Manager's Dashboard
              li.nav-item
                a.nav-link(href="/logout") Logout
    .container.mt-5.pt-5
      h1.text-center.mb-4 Update Stock
      form#myForm.p-4.shadow-lg.rounded.bg-light(
        action='/updateStock/' + stock._id,
        method="post",
        onsubmit='ValidityForm(event)'
      )
        .mb-3
          label.form-label(for='Pname') Produce Name:
          input#Pname.form-control(type='text', name='pname', value=stock.pname, required)
          span.text-danger#produce-error

        .mb-3
          label.form-label(for='Tproduce') Type of Produce:
          input#Tproduce.form-control(type='text', name='tproduce', value=stock.tproduce, required)
          span.text-danger#type-error

        .mb-3
          label.form-label(for='datePicker') Date of product input:
          input#datePicker.form-control(
            type='date',
            name='dproduct',
            value=stock.dproduct.toISOString().substring(0, 10),
            required
          )
          span.text-danger#date-error

        .mb-3
          label.form-label(for='timePicker') Time of product input:
          input#timePicker.form-control(type='time', name='tproduct', value=stock.tproduct, required)
          span.text-danger#time-error

        .mb-3
          label.form-label(for='Qsold') Quantity of product (kg):
          input#Qsold.form-control(type='number', name='qproduct', value=stock.qproduct, required)
          span.text-danger#quantity-error

        .mb-3
          label.form-label(for='Sprice') Unit Price per kg:
          input#Sprice.form-control(type='number', name='uprice', value=stock.uprice, required)
          span.text-danger#unit-error

        .mb-3
          label.form-label(for='Tamount') Total Amount:
          input#Tamount.form-control(type='number', name='tamount', value=stock.tamount, required)
          span.text-danger#total-error

        .mb-3
          label.form-label(for='customerName') Supplier Name:
          input#customerName.form-control(type='text', name='supplierName', value=stock.supplierName, required)
          span.text-danger#supplier-error

        .mb-3
          label.form-label(for='customerContact') Supplier Contact:
          input#customerContact.form-control(type='text', name='supplierContact', value=stock.supplierContact, required)
          span.text-danger#contact-error

        .mb-3
          label.form-label(for='branch') Branch:
          select#branch.form-select(name='branch', required)
            option(value='') Choose...
            option(value='Mattuga', selected=stock.branch === 'Mattuga') Mattuga
            option(value='Maganjo', selected=stock.branch === 'Maganjo') Maganjo
          span.text-danger#branch-error

        .mb-3
          label.form-label(for='autoSizingSelect') Payment Method:
          select#autoSizingSelect.form-select(name='paymentMethod', required)
            option(value='') Choose...
            option(value='Cash', selected=stock.paymentMethod === 'Cash') Cash
            option(value='Mobile Money', selected=stock.paymentMethod === 'Mobile Money') Mobile Money
            option(value='Bank Transfer', selected=stock.paymentMethod === 'Bank Transfer') Bank Transfer
          span.text-danger#payment-error

        button.btn.btn-success.w-100(type='submit') Submit

    script(src="/js/stock.js")
    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js',
      integrity='sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz',
      crossorigin='anonymous'
    )
