meta(charset="utf-8")
meta(name="viewport", content="width=device-width,initial-scale=1")
title Deferred Payments | Karibu Groceries Ltd

// Bootstrap CSS
link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
link(rel="stylesheet", href="/css/deferredPayments.css")

// Navigation
nav.navbar.navbar-expand-lg.bg-body-tertiary.fixed-top
  .container-fluid
    a.navbar-brand(href="#") Karibu Groceries Ltd
    button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
      span.navbar-toggler-icon
    .offcanvas.offcanvas-end#offcanvasNavbar
      .offcanvas-header
        h5.offcanvas-title KGL
        button.btn-close(type="button", data-bs-dismiss="offcanvas")
      .offcanvas-body
        ul.navbar-nav.ms-auto
          li.nav-item
            a.nav-link(href="../index.html") Home
          li.nav-item
            a.nav-link(href="login.html") Login
          li.nav-item
            a.nav-link(href="produce-procurement.html") Produce Procurement
          li.nav-item
            a.nav-link(href="stock.html") Stock
          li.nav-item
            a.nav-link(href="deffered-payments.html") Deferred Payments
          li.nav-item
            a.nav-link(href="sales.html") Sales
          li.nav-item
            a.nav-link(href="manager-dashboard.html") Manager's Dashboard
          li.nav-item
            a.nav-link(href="contacts.html") Contact

// Main Content
main.container.mt-5.pt-5
  section.mb-5
    h2.text-center.mb-4 Deferred Payment Plan
    .card.p-4.shadow-sm
      .row.mb-3
        .col-md-4
          strong Total Cost:
          |  UGX 2,000,000
        .col-md-4
          strong Deposit Paid:
          |  UGX 1,500,000
        .col-md-4
          strong Remaining:
          |  UGX 500,000
      div
        progress.w-100(value="75", max="100")
        p.text-center.mt-2 75% Paid
      .text-center.mt-4
        button.btn.btn-success.me-2 💳 Pay Now
        button.btn.btn-outline-primary 🗓️ Set Up Payment Plan

  section.mb-5
    h3.mb-3 Record Trusted Buyer Information
    form#buyerForm.row.g-3.needs-validation(action='/deferredPayments' method='post' onsubmit='validateDeferredForm(event)')
      .col-md-6
        label.form-label(for="buyerName") Buyer Name
        input.form-control#buyerName(type="text"  placeholder="Enter name")
        span.text-danger#buyerName-error

      .col-md-6
        label.form-label(for="nationalId") National ID
        input.form-control#nationalId(type="text" pattern="\d{3}-\d{4}-\d{3}"  placeholder="Enter ID e.g. 123-4567-890")
        span.text-danger#nationalId-error

      .col-md-6
        label.form-label(for="location") Location
        input.form-control#location(type="text" )
        span.text-danger#location-error

      .col-md-6
        label.form-label(for="contacts") Contact Number
        input.form-control#contacts(type="tel" )
        span.text-danger#contacts-error

      .col-md-6
        label.form-label(for="amountDue") Amount Due (UGX)
        input.form-control#amountDue(type="number" min="10000" )
        span.text-danger#amountDue-error

      .col-md-6
        label.form-label(for="salesAgent") Sales Agent
        input.form-control#salesAgent(type="text" )
        span.text-danger#salesAgent-error

      .col-md-6
        label.form-label(for="dueDate") Due Date
        input.form-control#dueDate(type="date" )
        span.text-danger#dueDate-error

      .col-md-6
        label.form-label(for="produceName") Produce Name
        input.form-control#produceName(type="text" )
        span.text-danger#produceName-error

      .col-md-6
        label.form-label(for="produceType") Produce Type
        input.form-control#produceType(type="text" )
        span.text-danger#produceType-error

      .col-md-6
        label.form-label(for="tonnage") Tonnage
        input.form-control#tonnage(type="number" )
        span.text-danger#tonnage-error

      .col-md-6
        label.form-label(for="dispatchDate") Dispatch Date
        input.form-control#dispatchDate(type="date" )
        span.text-danger#dispatchDate-error

      .col-12.text-center
        button.btn.btn-primary.mt-3(type="submit") Submit

// Bootstrap JS and custom script
script(src="/js/deferredPayments.js")
script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
