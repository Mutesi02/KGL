doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    title KGL Sales Agent Dashboard
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="/css/salesAgent.css")
    link(href='https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap', rel='stylesheet')
  body
    // Navbar
    nav.navbar.navbar-expand-lg.fixed-top
      .container-fluid
        a.navbar-brand(href="#", style="color: white;") KGL
        button.navbar-toggler(type="button", data-bs-toggle="offcanvas", data-bs-target="#offcanvasNavbar")
          span.navbar-toggler-icon
        .offcanvas.offcanvas-end#offcanvasNavbar
          .offcanvas-header
            h5.offcanvas-title KGL
            button.btn-close(type="button", data-bs-dismiss="offcanvas")
          .offcanvas-body
            ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
              li.nav-item: a.nav-link(href="/") Home
              li.nav-item: a.nav-link(href="/stockdata") Sales
              li.nav-item: a.nav-link(href="/deferredPayments") Deferred Payments
              li.nav-item: a.nav-link(href="/logout") Logout
    // Main Content
    section.dashboard.mt-6.pt-5
      .container
        h2.text-center.mb-4 Welcome, Agent #{agentName}
        .cards.d-flex.flex-wrap.gap-4.justify-content-center
          .card.p-3
            h3 Record Cash Sale
            button.btn.btn-success(onclick="showForm('cash')") Add Sale
          .card.p-3
            h3 Record Credit Sale
            button.btn.btn-warning(onclick="showForm('credit')") Add Credit Sale
          .card.p-3
            h3 View Stock
            button.btn.btn-info(onclick="showStock()") Check Stock
          .card.p-3
            h3 My Sales History
            button.btn.btn-primary(onclick="showHistory()") View History

        #form-section.hidden.mt-4
        #table-section.hidden.mt-4

        if sales.length
          h3.mt-5.text-center Sales History
          table.table.table-striped.mt-3
            thead
              tr
                th Date
                th Type
                th Produce
                th Quantity (kg)
                th Price/kg
                th Total
                th Buyer
                th Contact
                th Payment
                th Branch
            tbody
              each sale in sales
                tr
                  td= sale.saleDate.toDateString()
                  td= sale.saleType
                  td= sale.produceName
                  td= sale.quantitySold
                  td UGX #{sale.salePricePerKg.toLocaleString()}
                  td UGX #{sale.totalAmount.toLocaleString()}
                  td= sale.buyerName
                  td= sale.buyerContact
                  td= sale.paymentStatus
                  td= sale.branch
        else
          p.text-center.text-muted.mt-5 No sales data available.

    footer.text-center.mt-5.py-3.bg-success.text-white
      | Karibu Groceries Ltd — Sales Agent Dashboard © 2025

    script(src="/js/salesAgent.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")

