meta(charset="UTF-8")
meta(name="viewport", content="width=device-width,initial-scale=1")
title KGL Sales Agent Dashboard
link(rel="stylesheet", href="/css/salesAgent.css")
link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
nav.navbar
  .logo KGL
  .greeting Welcome, Agent Mutoni
  button.logout-btn Logout
section.dashboard
  .cards
    .card
      h3 Record Cash Sale
      button(onclick="showForm(\'cash\')") Add Sale
    .card
      h3 Record Credit Sale
      button(onclick="showForm(\'credit\')") Add Credit Sale
    .card
      h3 View Stock
      button(onclick="showStock()") Check Stock
    .card
      h3 My Sales History
      button(onclick="showHistory()") View History
  #form-section.form-section.hidden
    //  Dynamic forms will appear here 
  #table-section.table-section.hidden
    //  Dynamic tables will appear here 
footer.
  
  Karibu Groceries Ltd — Sales Agent Dashboard © 2025
  
script(src="/js/salesAgent.js")
script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")