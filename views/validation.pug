doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title DOM-Form Validation
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH' crossorigin='anonymous')
h2.container.my-4 Form Validation
form.row.g-3(onsubmit='return validateUserForm(event)')
  // Fullname
  .col-12
    label.form-label(for='fullname') Fullname
    input#fullname.form-control(type='text')
    small#fullnameError
  // Email
  .col-md-6
    label.form-label(for='email') Email
    input#email.form-control(type='text')
    small#emailError
  // Password
  .col-md-6
    label.form-label(for='password') Password
    input#password.form-control(type='password')
    small#passwordError
  // Address
  .col-12
    label.form-label(for='address') Address
    input#address.form-control(type='text' placeholder='1234 Main St')
    small#addressError
  // City
  .col-md-6
    label.form-label(for='city') City
    input#city.form-control(type='text')
    small#cityError
  // State
  .col-md-4
    label.form-label(for='inputState') State
    select#inputState.form-select
      option(value='') Choose...
      option(value='AL') Alabama
      option(value='AK') Alaska
      option(value='AZ') Arizona
      // Add additional states as needed
    small#stateError
  // Zip
  .col-md-2
    label.form-label(for='zip') Zip
    input#zip.form-control(type='text')
    small#zipError
  // Telephone: must be digits only
  .col-12
    label.form-label(for='telephone') Telephone
    input#telephone.form-control(type='text' placeholder='Enter phone number')
    small#telephoneError
  // Gender radio buttons: required selection
  fieldset.col-12
    legend Gender
    .form-check
      input#genderMale.form-check-input(type='radio' name='gender' value='male')
      label.form-check-label(for='genderMale') Male
    .form-check
      input#genderFemale.form-check-input(type='radio' name='gender' value='female')
      label.form-check-label(for='genderFemale') Female
    small#genderError
  // Terms and Conditions: checkbox required
  .col-12
    .form-check
      input#terms.form-check-input(type='checkbox')
      label.form-check-label(for='terms') Accept terms and conditions
    small#termsError
  // Submit Button
  .col-12
    button.btn.btn-primary(type='submit') Sign in
script(src='/js/formValidation.js')
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js' integrity='sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz' crossorigin='anonymous')
