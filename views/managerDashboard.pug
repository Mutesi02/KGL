doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title Manager's Dashboard
    link(rel="stylesheet", href="/css/managerDashboard.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    link(href='https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap', rel='stylesheet')
  body
    nav.navbar.navbar-expand-lg.fixed-top(style="background-color: #004d00;")
      .container-fluid
        a.navbar-brand.text-white(href='#') Karibu Groceries Ltd
        button.navbar-toggler(type='button' data-bs-toggle='offcanvas' data-bs-target='#offcanvasNavbar' aria-controls='offcanvasNavbar' aria-label='Toggle navigation')
          span.navbar-toggler-icon
        #offcanvasNavbar.offcanvas.offcanvas-end(tabindex='-1' aria-labelledby='offcanvasNavbarLabel')
          .offcanvas-header
            h5#offcanvasNavbarLabel.offcanvas-title.text-white KGL
            button.btn-close(type='button' data-bs-dismiss='offcanvas' aria-label='Close')
          .offcanvas-body
            ul.navbar-nav.justify-content-end.flex-grow-1.pe-3
              li.nav-item
                a.nav-link.text-white(aria-current='page' href='/') Home
              li.nav-item
                a.nav-link.text-white(href='/produceProcurement') Produce Procurement
              li.nav-item
                a.nav-link.text-white(href='/addStock') Stock
              li.nav-item
                a.nav-link.text-white(href='/stockdata') Sales
              li.nav-item
                a.nav-link.text-white(href='/deferredPayments') Deferred Payments
              li.nav-item
                a.nav-link.text-white(href='/') Logout

    .container.mt-5.pt-5
      h1 Dashboard
      p Overview of procurements, sales, inventory status, and notifications for out-of-stock items.

      .row.mb-4
        .col-lg-3.col-md-6
          .card.text-white.bg-primary.mb-3
            .card-body
              h5 Total Procurements
              p #{totalProcurements} kg
        .col-lg-3.col-md-6
          .card.text-white.bg-success.mb-3
            .card-body
              h5 Total Sales
              p #{totalSales} kg
        .col-lg-3.col-md-6
          .card.text-white.bg-warning.mb-3
            .card-body
              h5 Low Stock Alerts
              p #{lowStockCount}
        .col-lg-3.col-md-6
          .card.text-white.bg-danger.mb-3
            .card-body
              h5 Out of Stock Items
              p #{outOfStockCount}

      p.mt-4.mb-2 Recent Procurements
      table.table.table-striped.table-hover
        thead
          tr
            th(scope='col') #
            th(scope='col') Produce Name
            th(scope='col') Type
            th(scope='col') Tonnage (kg)
            th(scope='col') Cost (UGX)
            th(scope='col') Dealer Name
            th(scope='col') Branch
            th(scope='col') Date
        tbody
          if recentProcurements.length
            each p, index in recentProcurements
              tr
                th(scope='row') #{index + 1}
                td #{p.Pname}
                td #{p.Tproduce}
                td #{p.tonnage}
                td #{p.cost}
                td #{p.dealerName}
                td #{p.branchName}
                td #{p.Dprocurement ? p.Dprocurement.toDateString() : ''}
          else
            tr
              td(colspan='8') No recent procurements found.

      p.mt-5 Recent Sales
      table.table.table-striped.table-hover
        thead
          tr
            th(scope='col') #
            th(scope='col') Product Name
            th(scope='col') Tonnage (kg)
            th(scope='col') Amount Paid (UGX)
            th(scope='col') Buyer's Name
            th(scope='col') Sales Agent
            th(scope='col') Branch
            th(scope='col') Date
        tbody
          if recentSales.length
            each sale, index in recentSales
              tr
                th(scope='row') #{index + 1}
                td #{sale.pname}
                td #{sale.qsold}
                td #{sale.tamount}
                td #{sale.customerName}
                td #{sale.seller}
                td #{sale.branch}
                td #{sale.dsale ? sale.dsale.toDateString() : ''}
          else
            tr
              td(colspan='8') No recent sales found.

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
